<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <connectionStrings>
    <add name="StudentDBConnection"
         connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=StudentRegistrationDB;Integrated Security=True;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
	  <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <!-- Task 9: Email API settings used by EmailHelper.cs for every outbound email (OTP,
         Registration Confirmation, Admin Notification, Approval, Rejection). Sent via the
         SendGrid Web API v3 (https://api.sendgrid.com/v3/mail/send) over HTTPS - a real REST
         Email API call, not SMTP. Get a free API key at https://signup.sendgrid.com/ -->
    <add key="SendGridApiKey" value="SG.***********************************************" />

    <!-- Must be a "Verified Sender" (or a domain you've authenticated) in your SendGrid
         account - Settings -> Sender Authentication -> Verify a Single Sender. SendGrid
         rejects the send if this address isn't verified. -->
    <add key="EmailFromAddress" value="shravani.kesarkar20@gmail.com" />
    <add key="EmailFromName" value="StudentRegistrationSystem" />

    <!-- Recipient for the AdminNotification.html email -->
    <add key="AdminEmail" value="shravani.kesarkar20@gmail.com" />

    <!-- Task 9, Requirement 1/8: reliability + logging for the Email API layer.
         EmailMaxRetryAttempts: total attempts (including the first) for transient API
         failures (network errors / HTTP 429 / HTTP 5xx) before EmailHelper gives up and
         throws EmailDeliveryException.
         LogFolderPath: where AppLogger writes daily rolling logs of every email attempt. -->
    <add key="EmailMaxRetryAttempts" value="2" />
    <add key="LogFolderPath" value="~/App_Data/Logs/" />

    <!-- OTP configuration -->
    <add key="OTPExpiryMinutes" value="10" />

    <!-- Photo upload -->
    <add key="StudentPhotoUploadPath" value="~/Uploads/Students/" />
    <add key="MaxPhotoSizeMB" value="2" />

    <!-- Task 10: Rich Text Editor image uploads (used by RichTextImageUpload.ashx). -->
    <add key="RichTextImageUploadPath" value="~/Uploads/RichTextImages/" />
    <add key="RichTextImageMaxSizeMB" value="5" />

    <!-- Task 11: Advertisement Modal image/banner uploads. -->
    <add key="AdvertisementImageUploadPath" value="~/Uploads/Advertisements/" />
    <add key="AdvertisementImageMaxSizeMB" value="5" />

    <!-- Task 13: Home Page slide/banner image uploads. -->
    <add key="HomeBannerImageUploadPath" value="~/Uploads/HomeBanners/" />
    <add key="HomeBannerImageMaxSizeMB" value="5" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8">
      <assemblies>
        <add assembly="System.IO.Compression, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
        <add assembly="System.IO.Compression.FileSystem, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
      </assemblies>
    </compilation>
    <!-- maxRequestLength raised from 4096 to 10240 KB (10 MB) in Task 10 to comfortably fit a
         5 MB Rich Text Editor image upload (RichTextImageMaxSizeMB) plus the surrounding
         multipart/form-data overhead and the document's own HTML content. -->
    <httpRuntime targetFramework="4.8" maxRequestLength="10240" executionTimeout="120" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" />
    <sessionState mode="InProc" timeout="30" cookieless="false" />

    <!-- Task 8, Requirement 5: show a friendly error page to real visitors instead of a raw
         stack trace, while still showing full diagnostics to developers on localhost.
         Set mode="Off" temporarily while debugging locally if you want to see raw exceptions
         from a non-localhost machine too. -->
    <customErrors mode="RemoteOnly" defaultRedirect="Error.aspx" />

    <!-- Belt-and-braces: authentication cookies/session are not sent over plain HTTP in
         production. Has no effect over http:// during local development. -->
    <httpCookies requireSSL="false" httpOnlyCookies="true" />
  </system.web>

  <system.webServer>
    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <modules runAllManagedModulesForAllRequests="true" />
    <directoryBrowse enabled="false" />
    <!-- Task 10: IIS-level counterpart to httpRuntime/maxRequestLength above (10 MB), so an
         image upload isn't rejected at the web-server layer before it reaches ASP.NET. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
  </system.webServer>

</configuration>
